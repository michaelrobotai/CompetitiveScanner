# Environment variables for Docker setup
# Copy this to .env and fill in values

TZ=UTC
PORT=3000
DB_HOST=db
DB_NAME=competitive_radar
DB_PORT=3306
DB_USER=radar_user
NODE_ENV=production
REDIS_URL=redis://cache:6379
SCAN_CRON=0 6 * * *
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
JWT_SECRET=changeme_jwt_secret
DB_PASSWORD=changeme_db_password
APP_BASE_URL=http://localhost:3000
SMTP_PASSWORD=changeme_smtp_password
OPENAI_API_KEY=sk-changeme
SESSION_SECRET=changeme_session_secret
DB_ROOT_PASSWORD=changeme_root_password
DIGEST_FROM_EMAIL=radar@example.com
SCAN_RATE_LIMIT_PER_MIN=60