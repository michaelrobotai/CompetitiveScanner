<%- include('../partials/head') %>
<div class="rad-shell">
  <%- include('../partials/sidebar') %>
  <div class="rad-main">
    <%- include('../partials/topbar', { crumb: 'Monitor', heading: 'Signals Feed', scanReturnTo: 'signals' }) %>
    <div class="rad-content">
      <%- include('../partials/flash') %>

      <form class="rad-filters" method="get" data-autosubmit>
        <div class="row g-2 align-items-end">
          <div class="col-md-3">
            <label class="form-label">Search</label>
            <input class="form-control form-control-sm" type="search" name="q" value="<%= filters.q || '' %>" placeholder="Title or summary…">
          </div>
          <div class="col-md-2">
            <label class="form-label">Competitor</label>
            <select class="form-select form-select-sm" name="competitorId">
              <option value="">All</option>
              <% competitorOptions.forEach(function (c) { %>
                <option value="<%= c.id %>" <%= String(filters.competitorId) === String(c.id) ? 'selected' : '' %>><%= c.name %></option>
              <% }); %>
            </select>
          </div>
          <div class="col-md-2">
            <label class="form-label">Category</label>
            <select class="form-select form-select-sm" name="type">
              <option value="">All</option>
              <% Object.keys(f.SIGNAL_TYPES).forEach(function (k) { %>
                <option value="<%= k %>" <%= filters.type === k ? 'selected' : '' %>><%= f.SIGNAL_TYPES[k].label %></option>
              <% }); %>
            </select>
          </div>
          <div class="col-md-1">
            <label class="form-label">Severity</label>
            <select class="form-select form-select-sm" name="severity">
              <option value="">Any</option>
              <% ['critical','high','medium','low'].forEach(function (s) { %>
                <option value="<%= s %>" <%= filters.severity === s ? 'selected' : '' %>><%= f.titleCase(s) %></option>
              <% }); %>
            </select>
          </div>
          <div class="col-md-1">
            <label class="form-label">Status</label>
            <select class="form-select form-select-sm" name="status">
              <option value="">Any</option>
              <% ['new','reviewed','confirmed','dismissed'].forEach(function (s) { %>
                <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= f.titleCase(s) %></option>
              <% }); %>
            </select>
          </div>
          <div class="col-md-1">
            <label class="form-label">Min conf.</label>
            <select class="form-select form-select-sm" name="minConfidence">
              <% [0,40,50,60,70,80,90].forEach(function (n) { %>
                <option value="<%= n %>" <%= String(filters.minConfidence || 0) === String(n) ? 'selected' : '' %>><%= n === 0 ? 'Any' : n %></option>
              <% }); %>
            </select>
          </div>
          <div class="col-md-1">
            <label class="form-label">From</label>
            <input class="form-control form-control-sm" type="date" name="from" value="<%= filters.from || '' %>">
          </div>
          <div class="col-md-1">
            <label class="form-label">To</label>
            <input class="form-control form-control-sm" type="date" name="to" value="<%= filters.to || '' %>">
          </div>
        </div>
        <div class="d-flex gap-2 mt-2">
          <button class="btn btn-rad btn-sm" type="submit"><i class="fa-solid fa-filter"></i>Apply filters</button>
          <a class="btn btn-ghost btn-sm" href="<%= u('signals') %>"><i class="fa-solid fa-rotate-left"></i>Reset</a>
          <div class="ms-auto d-flex gap-2 align-items-center flex-wrap">
            <% counts.forEach(function (c) { %>
              <span class="rad-chip"><i class="<%= f.signalIcon(c.signal_type) %>"></i><%= f.signalLabel(c.signal_type) %> · <strong><%= c.n %></strong></span>
            <% }); %>
          </div>
        </div>
      </form>

      <div class="rad-card">
        <div class="rad-card-head">
          <h2>Signals</h2>
          <span class="rad-sub"><%= data.pager.total %> match your filters</span>
        </div>
        <div class="rad-card-body tight">
          <% if (!data.rows.length) { %>
            <div class="rad-empty">
              <i class="fa-solid fa-tower-broadcast"></i>
              <strong>No signals found</strong>
              Adjust the filters, or run a scan to collect and analyse fresh items.
            </div>
          <% } else { %>
            <div class="rad-table-wrap">
              <table class="rad-table">
                <thead>
                  <tr>
                    <th><a href="?<%= qs(filters, { sort: 'competitor', dir: data.sort === 'competitor' && data.dir === 'asc' ? 'desc' : 'asc' }) %>">Competitor <i class="fa-solid fa-sort"></i></a></th>
                    <th>Signal</th>
                    <th><a href="?<%= qs(filters, { sort: 'type', dir: data.sort === 'type' && data.dir === 'asc' ? 'desc' : 'asc' }) %>">Category <i class="fa-solid fa-sort"></i></a></th>
                    <th style="min-width:130px;"><a href="?<%= qs(filters, { sort: 'confidence', dir: data.sort === 'confidence' && data.dir === 'asc' ? 'desc' : 'asc' }) %>">Confidence <i class="fa-solid fa-sort"></i></a></th>
                    <th class="num"><a href="?<%= qs(filters, { sort: 'impact', dir: data.sort === 'impact' && data.dir === 'asc' ? 'desc' : 'asc' }) %>">Impact <i class="fa-solid fa-sort"></i></a></th>
                    <th><a href="?<%= qs(filters, { sort: 'severity', dir: data.sort === 'severity' && data.dir === 'asc' ? 'desc' : 'asc' }) %>">Severity <i class="fa-solid fa-sort"></i></a></th>
                    <th>Status</th>
                    <th class="nowrap"><a href="?<%= qs(filters, { sort: 'detected_at', dir: data.sort === 'detected_at' && data.dir === 'asc' ? 'desc' : 'asc' }) %>">Detected <i class="fa-solid fa-sort"></i></a></th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <% data.rows.forEach(function (s) { %>
                    <tr>
                      <td class="nowrap"><a href="<%= u('competitors/' + s.competitor_id) %>"><%= s.competitor_name %></a></td>
                      <td>
                        <a class="rad-td-title" href="<%= u('signals/' + s.id) %>"><%= f.truncate(s.title, 78) %></a>
                        <div class="rad-td-sub"><%= s.evidence_count %> evidence · <%= s.corroborating_sources %> source type(s)</div>
                      </td>
                      <td class="nowrap tp-<%= f.signalColor(s.signal_type) %>" style="color:var(--tp);font-weight:600;font-size:12.5px;">
                        <i class="<%= f.signalIcon(s.signal_type) %>"></i> <%= f.signalLabel(s.signal_type) %>
                      </td>
                      <td>
                        <div class="rad-conf">
                          <span class="rad-conf-num"><%= s.confidence %></span>
                          <div class="rad-meter <%= s.confidence >= 70 ? 'm-high' : (s.confidence >= 50 ? 'm-mid' : 'm-low') %>"><span style="width:<%= s.confidence %>%"></span></div>
                        </div>
                      </td>
                      <td class="num"><%= s.impact %></td>
                      <td><span class="rad-badge <%= f.SEVERITY_META[s.severity].badge %>"><%= f.SEVERITY_META[s.severity].label %></span></td>
                      <td><span class="rad-badge <%= f.STATUS_META[s.status].badge %>"><%= f.STATUS_META[s.status].label %></span></td>
                      <td class="nowrap rad-td-sub" title="<%= f.fmtDateTime(s.detected_at) %>"><%= f.timeAgo(s.detected_at) %></td>
                      <td class="nowrap"><a class="btn btn-ghost btn-xs" href="<%= u('signals/' + s.id) %>"><i class="fa-solid fa-arrow-right"></i></a></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
        <%- include('../partials/pager', { pager: data.pager, filters: filters }) %>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/foot') %>
