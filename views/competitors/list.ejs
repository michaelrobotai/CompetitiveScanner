<%- include('../partials/head') %>
<div class="rad-shell">
  <%- include('../partials/sidebar') %>
  <div class="rad-main">
    <%- include('../partials/topbar', {
      crumb: 'Monitor', heading: 'Competitors', scanReturnTo: 'competitors',
      extraActions: can('competitors.manage') ? '<a class="btn btn-ghost btn-sm" href="' + u('competitors/new') + '"><i class="fa-solid fa-plus"></i>Add competitor</a>' : ''
    }) %>
    <div class="rad-content">
      <%- include('../partials/flash') %>

      <form class="rad-filters" method="get" data-autosubmit>
        <div class="row g-2 align-items-end">
          <div class="col-md-4">
            <label class="form-label">Search</label>
            <input class="form-control form-control-sm" type="search" name="q" value="<%= filters.q || '' %>" placeholder="Name, industry or tag…">
          </div>
          <div class="col-md-2">
            <label class="form-label">Tracking</label>
            <select class="form-select form-select-sm" name="status">
              <option value="">All</option>
              <% ['active','paused','archived'].forEach(function (s) { %>
                <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= f.titleCase(s) %></option>
              <% }); %>
            </select>
          </div>
          <div class="col-md-2">
            <label class="form-label">Priority</label>
            <select class="form-select form-select-sm" name="priority">
              <option value="">Any</option>
              <% ['high','medium','low'].forEach(function (p) { %>
                <option value="<%= p %>" <%= filters.priority === p ? 'selected' : '' %>><%= f.titleCase(p) %></option>
              <% }); %>
            </select>
          </div>
          <div class="col-md-2">
            <label class="form-label">Industry</label>
            <select class="form-select form-select-sm" name="industry">
              <option value="">All</option>
              <% data.industries.forEach(function (i) { %>
                <option value="<%= i %>" <%= filters.industry === i ? 'selected' : '' %>><%= i %></option>
              <% }); %>
            </select>
          </div>
          <div class="col-md-2 d-flex gap-2">
            <button class="btn btn-rad btn-sm w-100" type="submit"><i class="fa-solid fa-magnifying-glass"></i>Filter</button>
            <a class="btn btn-ghost btn-sm" href="<%= u('competitors') %>"><i class="fa-solid fa-rotate-left"></i></a>
          </div>
        </div>
      </form>

      <div class="rad-card">
        <div class="rad-card-head">
          <h2>Tracked competitors</h2>
          <span class="rad-sub"><%= data.pager.total %> total</span>
        </div>
        <div class="rad-card-body tight">
          <% if (!data.rows.length) { %>
            <div class="rad-empty">
              <i class="fa-solid fa-building-columns"></i>
              <strong>No competitors match your filters</strong>
              <% if (can('competitors.manage')) { %>
                <a class="btn btn-rad btn-sm mt-3" href="<%= u('competitors/new') %>"><i class="fa-solid fa-plus"></i>Add your first competitor</a>
              <% } %>
            </div>
          <% } else { %>
            <div class="rad-table-wrap">
              <table class="rad-table">
                <thead>
                  <tr>
                    <th><a href="?<%= qs(filters, { sort: 'name', dir: data.sort === 'name' && data.dir === 'asc' ? 'desc' : 'asc' }) %>">Competitor <i class="fa-solid fa-sort"></i></a></th>
                    <th><a href="?<%= qs(filters, { sort: 'priority', dir: data.sort === 'priority' && data.dir === 'asc' ? 'desc' : 'asc' }) %>">Priority <i class="fa-solid fa-sort"></i></a></th>
                    <th><a href="?<%= qs(filters, { sort: 'status', dir: data.sort === 'status' && data.dir === 'asc' ? 'desc' : 'asc' }) %>">Tracking <i class="fa-solid fa-sort"></i></a></th>
                    <th class="num">Sources</th>
                    <th class="num"><a href="?<%= qs(filters, { sort: 'signals', dir: data.sort === 'signals' && data.dir === 'asc' ? 'desc' : 'asc' }) %>">Signals <i class="fa-solid fa-sort"></i></a></th>
                    <th>Top confidence</th>
                    <th><a href="?<%= qs(filters, { sort: 'last_signal', dir: data.sort === 'last_signal' && data.dir === 'asc' ? 'desc' : 'asc' }) %>">Last signal <i class="fa-solid fa-sort"></i></a></th>
                    <th class="nowrap"></th>
                  </tr>
                </thead>
                <tbody>
                  <% data.rows.forEach(function (c) { %>
                    <tr>
                      <td>
                        <a class="rad-td-title" href="<%= u('competitors/' + c.id) %>"><%= c.name %></a>
                        <div class="rad-td-sub">
                          <%= c.industry || 'Industry not set' %><%= c.hq_country ? ' · ' + c.hq_country : '' %><%= c.ticker ? ' · ' + c.ticker : '' %>
                        </div>
                      </td>
                      <td><span class="rad-badge <%= c.priority === 'high' ? 'sev-high' : (c.priority === 'low' ? 'sev-low' : 'sev-medium') %>"><%= f.titleCase(c.priority) %></span></td>
                      <td>
                        <span class="rad-badge <%= c.tracking_status === 'active' ? 'st-confirmed' : (c.tracking_status === 'paused' ? 'sev-medium' : 'st-dismissed') %>">
                          <%= f.titleCase(c.tracking_status) %>
                        </span>
                      </td>
                      <td class="num"><%= c.source_count %></td>
                      <td class="num">
                        <strong><%= c.signal_count %></strong>
                        <% if (Number(c.new_signal_count) > 0) { %><span class="rad-badge st-new ms-1"><%= c.new_signal_count %> new</span><% } %>
                      </td>
                      <td>
                        <% if (c.top_confidence) { %>
                          <div class="rad-conf">
                            <span class="rad-conf-num"><%= c.top_confidence %></span>
                            <div class="rad-meter <%= c.top_confidence >= 70 ? 'm-high' : (c.top_confidence >= 50 ? 'm-mid' : 'm-low') %>"><span style="width:<%= c.top_confidence %>%"></span></div>
                          </div>
                        <% } else { %><span class="text-muted-2">—</span><% } %>
                      </td>
                      <td class="nowrap rad-td-sub"><%= c.last_signal_at ? f.timeAgo(c.last_signal_at) : '—' %></td>
                      <td class="nowrap">
                        <a class="btn btn-ghost btn-xs" href="<%= u('competitors/' + c.id) %>" title="Open"><i class="fa-solid fa-arrow-right"></i></a>
                        <% if (can('competitors.manage')) { %>
                          <a class="btn btn-ghost btn-xs" href="<%= u('competitors/' + c.id + '/edit') %>" title="Edit"><i class="fa-solid fa-pen"></i></a>
                        <% } %>
                        <% if (can('runs.trigger')) { %>
                          <form action="<%= u('runs/trigger') %>" method="post" class="rad-inline-form" data-busy="…">
                            <input type="hidden" name="competitorId" value="<%= c.id %>">
                            <input type="hidden" name="returnTo" value="competitors">
                            <button class="btn btn-ghost btn-xs" type="submit" title="Scan now"><i class="fa-solid fa-bolt"></i></button>
                          </form>
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
        <%- include('../partials/pager', { pager: data.pager, filters: filters }) %>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/foot') %>
