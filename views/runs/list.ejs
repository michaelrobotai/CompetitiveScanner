<%- include('../partials/head') %>
<div class="rad-shell">
  <%- include('../partials/sidebar') %>
  <div class="rad-main">
    <%- include('../partials/topbar', { crumb: 'Collection', heading: 'Run History / Scan Runs', scanReturnTo: 'runs' }) %>
    <div class="rad-content">
      <%- include('../partials/flash') %>

      <% if (running) { %>
        <div class="rad-flash warn"><i class="fa-solid fa-circle-notch fa-spin"></i><div>A scan run is currently executing. Reload this page in a moment to see its results.</div></div>
      <% } %>

      <div class="row g-3 mb-3">
        <div class="col-lg-8">
          <form class="rad-filters mb-0" method="get" data-autosubmit>
            <div class="row g-2 align-items-end">
              <div class="col-md-4">
                <label class="form-label">Competitor</label>
                <select class="form-select form-select-sm" name="competitorId">
                  <option value="">All</option>
                  <% competitorOptions.forEach(function (c) { %>
                    <option value="<%= c.id %>" <%= String(filters.competitorId) === String(c.id) ? 'selected' : '' %>><%= c.name %></option>
                  <% }); %>
                </select>
              </div>
              <div class="col-md-3">
                <label class="form-label">Status</label>
                <select class="form-select form-select-sm" name="status">
                  <option value="">Any</option>
                  <% ['completed','partial','failed','running','queued'].forEach(function (s) { %>
                    <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= f.titleCase(s) %></option>
                  <% }); %>
                </select>
              </div>
              <div class="col-md-3">
                <label class="form-label">Run type</label>
                <select class="form-select form-select-sm" name="runType">
                  <option value="">Any</option>
                  <% ['scheduled','manual_all','manual_single','retry'].forEach(function (s) { %>
                    <option value="<%= s %>" <%= filters.runType === s ? 'selected' : '' %>><%= f.titleCase(s) %></option>
                  <% }); %>
                </select>
              </div>
              <div class="col-md-2">
                <a class="btn btn-ghost btn-sm w-100" href="<%= u('runs') %>"><i class="fa-solid fa-rotate-left"></i>Reset</a>
              </div>
            </div>
          </form>
        </div>
        <div class="col-lg-4">
          <div class="rad-card h-100">
            <div class="rad-card-body">
              <% if (can('runs.trigger')) { %>
                <form method="post" action="<%= u('runs/trigger') %>" data-busy="Running scan…">
                  <input type="hidden" name="returnTo" value="runs">
                  <div class="row g-2 align-items-end">
                    <div class="col-7">
                      <label class="form-label">Manual scan scope</label>
                      <select class="form-select form-select-sm" name="competitorId">
                        <option value="">All competitors</option>
                        <% competitorOptions.forEach(function (c) { %>
                          <option value="<%= c.id %>"><%= c.name %></option>
                        <% }); %>
                      </select>
                    </div>
                    <div class="col-5">
                      <button class="btn btn-rad btn-sm w-100" type="submit"><i class="fa-solid fa-bolt"></i>Run now</button>
                    </div>
                  </div>
                  <div class="form-check mt-2">
                    <input class="form-check-input" type="checkbox" id="onlyFailed" name="onlyFailed" value="1">
                    <label class="form-check-label" for="onlyFailed">Retry only previously failing sources</label>
                  </div>
                </form>
              <% } else { %>
                <p class="text-muted-2 mb-0" style="font-size:13px;"><i class="fa-solid fa-lock me-2"></i>Viewers cannot trigger scan runs.</p>
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <div class="rad-card">
        <div class="rad-card-head"><h2>Scan runs</h2><span class="rad-sub"><%= data.pager.total %> recorded</span></div>
        <div class="rad-card-body tight">
          <% if (!data.rows.length) { %>
            <div class="rad-empty">
              <i class="fa-solid fa-clock-rotate-left"></i>
              <strong>No scan runs yet</strong>
              Runs happen daily on a schedule, or on demand with the button above.
            </div>
          <% } else { %>
            <div class="rad-table-wrap">
              <table class="rad-table">
                <thead>
                  <tr>
                    <th>Run</th>
                    <th><a href="?<%= qs(filters, { sort: 'status', dir: data.sort === 'status' && data.dir === 'asc' ? 'desc' : 'asc' }) %>">Status <i class="fa-solid fa-sort"></i></a></th>
                    <th>Scope</th>
                    <th class="num">Sources</th>
                    <th class="num"><a href="?<%= qs(filters, { sort: 'items', dir: data.sort === 'items' && data.dir === 'asc' ? 'desc' : 'asc' }) %>">Items <i class="fa-solid fa-sort"></i></a></th>
                    <th class="num"><a href="?<%= qs(filters, { sort: 'signals', dir: data.sort === 'signals' && data.dir === 'asc' ? 'desc' : 'asc' }) %>">Signals <i class="fa-solid fa-sort"></i></a></th>
                    <th class="num"><a href="?<%= qs(filters, { sort: 'duration', dir: data.sort === 'duration' && data.dir === 'asc' ? 'desc' : 'asc' }) %>">Duration <i class="fa-solid fa-sort"></i></a></th>
                    <th>Triggered by</th>
                    <th class="nowrap"><a href="?<%= qs(filters, { sort: 'started_at', dir: data.sort === 'started_at' && data.dir === 'asc' ? 'desc' : 'asc' }) %>">Started <i class="fa-solid fa-sort"></i></a></th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <% data.rows.forEach(function (r) { %>
                    <tr>
                      <td>
                        <a class="rad-td-title" href="<%= u('runs/' + r.id) %>">#<%= r.id %></a>
                        <div class="rad-td-sub"><%= f.titleCase(r.run_type) %></div>
                      </td>
                      <td><span class="rad-badge <%= r.status === 'completed' ? 'st-confirmed' : (r.status === 'partial' ? 'sev-medium' : (r.status === 'failed' ? 'sev-critical' : 'st-new')) %>"><%= f.titleCase(r.status) %></span></td>
                      <td class="rad-td-sub"><%= r.competitor_name || (r.competitors_scanned + ' competitor(s)') %></td>
                      <td class="num nowrap">
                        <span title="ok"><%= r.sources_ok %></span> /
                        <span class="text-danger" title="failed"><%= r.sources_failed %></span> /
                        <span class="text-muted-2" title="not configured"><%= r.sources_not_configured %></span>
                      </td>
                      <td class="num"><%= r.items_collected %></td>
                      <td class="num"><strong><%= r.signals_created %></strong><% if (r.signals_merged) { %> <span class="rad-td-sub">+<%= r.signals_merged %>m</span><% } %></td>
                      <td class="num nowrap"><%= f.fmtDuration(r.duration_ms) %></td>
                      <td class="rad-td-sub nowrap"><%= r.triggered_by_name || 'Scheduler' %></td>
                      <td class="nowrap rad-td-sub" title="<%= f.fmtDateTime(r.started_at) %>"><%= f.timeAgo(r.started_at) %></td>
                      <td class="nowrap"><a class="btn btn-ghost btn-xs" href="<%= u('runs/' + r.id) %>"><i class="fa-solid fa-arrow-right"></i></a></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
        <%- include('../partials/pager', { pager: data.pager, filters: filters }) %>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/foot') %>
