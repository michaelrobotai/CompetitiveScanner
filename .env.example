# ── Competitive Radar configuration ─────────────────────────────────────────
# Database (injected automatically by the platform runtime — do not hardcode)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# HTTP port is injected by the runtime (process.env.PORT). Never hardcode it.

# Session
SESSION_SECRET=change-me-in-production

# Demo mode: when true, unconfigured source adapters emit realistic mock items
# so the whole collection -> analysis -> signal pipeline is demonstrable.
DEMO_MODE=true

# Scheduler (node-cron expressions, server local time)
DAILY_SCAN_CRON=0 6 * * *
DIGEST_CRON=15 7 * * *
RETRY_FAILED_CRON=0 */3 * * *
SCHEDULER_ENABLED=true

# Signal engine thresholds (business rules BR-04 / BR-05 / BR-11)
SIGNAL_MIN_CONFIDENCE=45
ALERT_MIN_IMPACT=80
ALERT_MIN_CONFIDENCE=70
DEDUPE_WINDOW_HOURS=72

# SMTP (leave blank to log digests to notification_logs instead of sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
DIGEST_FROM=radar@competitive-radar.local

# ── Source adapter API keys (blank => adapter reports "not_configured") ─────
NEWS_API_KEY=
LINKEDIN_API_KEY=
LINKEDIN_EXEC_API_KEY=
JOBS_API_KEY=
FUNDING_API_KEY=
SEC_API_KEY=
REVIEW_API_KEY=
SOCIAL_API_KEY=
